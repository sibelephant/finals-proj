PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# The server refuses to start on a short or placeholder value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GENERATE-A-UNIQUE-48-BYTE-RANDOM-VALUE-BEFORE-RUNNING
DB_HOST=127.0.0.1
# docker-compose publishes the container's 5432 as 5433 on the host.
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=etax_filing
DB_TEST_NAME=etax_filing_test

# Generate strong values before deploying. Copy this file to .env.production
# and fill in real values:
#
#   cp .env.production.example .env.production
#
# Generate a JWT secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Generate a DB password:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

JWT_SECRET=
DB_USER=etax_admin
DB_PASSWORD=
DB_NAME=etax_filing

# The public URL users visit (used for CORS). No trailing slash.
CLIENT_ORIGIN=https://yourdomain.com

# Host port the client container binds to (default 80)
HOST_PORT=80

